<UserControl x:Class="RCDragManagerProd.WPF.Views.MoneySheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.Surface}"
             FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: title and prices -->
        <Border Grid.Row="0" Padding="24,10,24,2"
                BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock x:Name="LblTitle" Text="Money" DockPanel.Dock="Left" VerticalAlignment="Top"
                           FontSize="{StaticResource FontSize.Lg}" FontWeight="Medium" Margin="0,4,24,0"
                           Foreground="{StaticResource Brush.TextPrimary}"/>
                <WrapPanel x:Name="PricePanel" Orientation="Horizontal"/>
            </DockPanel>
        </Border>

        <!-- Add drivers (setup only) -->
        <Border x:Name="AddBar" Grid.Row="1" Padding="24,6"
                BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Driver name" VerticalAlignment="Center" DockPanel.Dock="Left"
                           FontSize="{StaticResource FontSize.Sm}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtAddName" DockPanel.Dock="Left" Width="200"
                         Style="{StaticResource Style.TextBox.Compact}" KeyDown="TxtAddName_KeyDown"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource Style.Button.Toolbar}" Margin="8,0,0,0"
                        Content="Add" Click="BtnAdd_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Style.Button.Toolbar}"
                        Content="Add everyone in this event's classes" Click="BtnAddAll_Click"/>
            </DockPanel>
        </Border>

        <DataGrid x:Name="DgMoney" Grid.Row="2" Margin="24,8" CanUserSortColumns="False"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" HeadersVisibility="Column"/>

        <!-- Footer: totals -->
        <Border Grid.Row="3" Padding="24,8"
                Background="{StaticResource Brush.Chrome}"
                BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="LblMessage" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                           FontSize="{StaticResource FontSize.Sm}" Foreground="{StaticResource Brush.TextMuted}"/>
                <TextBlock x:Name="LblPots" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontSize="{StaticResource FontSize.Md}" FontWeight="Medium"
                           Foreground="{StaticResource Brush.TextPrimary}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
