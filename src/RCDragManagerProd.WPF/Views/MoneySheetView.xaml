<UserControl x:Class="RCDragManagerProd.WPF.Views.MoneySheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.Surface}"
             FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: fees -->
        <Border Grid.Row="0" Padding="24,14"
                BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="LblTitle" Text="Money"
                           FontSize="{StaticResource FontSize.Xl}" FontWeight="Medium"
                           Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBlock x:Name="LblHint" Text="Tick what each driver has paid."
                           FontSize="{StaticResource FontSize.Sm}"
                           Foreground="{StaticResource Brush.TextMuted}" Margin="0,3,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Track fee per day $" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Sm}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtTrackFee" Style="{StaticResource Style.TextBox.Compact}" Width="70"
                             LostKeyboardFocus="Fee_LostFocus"/>
                    <TextBlock Text="Entry fee per class $" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Sm}" Foreground="{StaticResource Brush.TextMuted}" Margin="20,0,6,0"/>
                    <TextBox x:Name="TxtEntryFee" Style="{StaticResource Style.TextBox.Compact}" Width="70"
                             LostKeyboardFocus="Fee_LostFocus"/>
                    <TextBlock Text="Buyback fee $" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Sm}" Foreground="{StaticResource Brush.TextMuted}" Margin="20,0,6,0"/>
                    <TextBox x:Name="TxtBuybackFee" Style="{StaticResource Style.TextBox.Compact}" Width="70"
                             LostKeyboardFocus="Fee_LostFocus"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Add drivers -->
        <Border x:Name="AddBar" Grid.Row="1" Padding="24,10"
                BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Driver name" VerticalAlignment="Center" DockPanel.Dock="Left"
                           FontSize="{StaticResource FontSize.Sm}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtAddName" DockPanel.Dock="Left" Width="200"
                         Style="{StaticResource Style.TextBox.Compact}" KeyDown="TxtAddName_KeyDown"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource Style.Button.Toolbar}" Margin="8,0,0,0"
                        Content="Add" Click="BtnAdd_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Style.Button.Toolbar}"
                        Content="Add everyone in this event's classes" Click="BtnAddAll_Click"/>
            </DockPanel>
        </Border>

        <DataGrid x:Name="DgMoney" Grid.Row="2" Margin="24,12"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" HeadersVisibility="Column"/>

        <!-- Footer -->
        <Border Grid.Row="3" Padding="24,12"
                Background="{StaticResource Brush.Chrome}"
                BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock x:Name="LblPots" TextWrapping="Wrap"
                           FontSize="{StaticResource FontSize.Lg}" FontWeight="Medium"
                           Foreground="{StaticResource Brush.TextPrimary}"/>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock x:Name="LblMessage" DockPanel.Dock="Left" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Sm}" Foreground="{StaticResource Brush.TextMuted}"/>
                    <TextBlock x:Name="LblTotal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Sm}" Foreground="{StaticResource Brush.TextMuted}"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
