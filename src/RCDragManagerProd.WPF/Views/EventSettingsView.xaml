<UserControl x:Class="RCDragManagerProd.WPF.Views.EventSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.Surface}"
             FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Event header -->
        <Border Grid.Row="0" Padding="24,16"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.BorderSubtle}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="LblEventName"
                           FontSize="{StaticResource FontSize.Xl}"
                           FontWeight="Medium"
                           Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBlock x:Name="LblEventMeta"
                           FontSize="{StaticResource FontSize.Sm}"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
            <StackPanel>

                <!-- Classes -->
                <TextBlock Text="Classes"
                           FontSize="{StaticResource FontSize.Xs}"
                           FontWeight="Medium"
                           Foreground="{StaticResource Brush.TextHint}"
                           Margin="0,0,0,8"/>

                <ItemsControl x:Name="IcClasses" Margin="0,0,0,28">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Brush.Background}"
                                    BorderBrush="{StaticResource Brush.BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Panel}"
                                    Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ClassName}"
                                                   FontSize="{StaticResource FontSize.Md}"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource Brush.TextPrimary}"/>
                                        <TextBlock FontSize="{StaticResource FontSize.Xs}"
                                                   Foreground="{StaticResource Brush.TextMuted}"
                                                   Margin="0,2,0,0">
                                            <Run Text="{Binding RaceType, Mode=OneWay}"/>
                                            <Run Text="·"/>
                                            <Run Text="{Binding Status, Mode=OneWay}"/>
                                            <Run Text="·"/>
                                            <Run Text="{Binding DriverSummary, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                Margin="16,0,16,0">
                                        <CheckBox Style="{StaticResource Style.CheckBox}"
                                                  Content="Buybacks"
                                                  IsChecked="{Binding BuybacksEnabled, Mode=OneWay}"
                                                  IsEnabled="{Binding CanChangeBuybacks}"
                                                  Tag="{Binding Index}"
                                                  Click="Buybacks_Click"
                                                  ToolTip="{Binding BuybackHint}"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Style="{StaticResource Style.Button.Toolbar.Danger}"
                                            Content="Reset class"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding CanReset}"
                                            Tag="{Binding Index}"
                                            Click="ResetClass_Click"
                                            ToolTip="{Binding ResetHint}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Appearance -->
                <TextBlock Text="Appearance"
                           FontSize="{StaticResource FontSize.Xs}"
                           FontWeight="Medium"
                           Foreground="{StaticResource Brush.TextHint}"
                           Margin="0,0,0,8"/>

                <Border Background="{StaticResource Brush.Background}"
                        BorderBrush="{StaticResource Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Panel}"
                        Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbDark" Style="{StaticResource Style.RadioButton}"
                                         Content="Dark" GroupName="EvtTheme"
                                         Checked="Theme_Checked" Margin="0,0,24,0"/>
                            <RadioButton x:Name="RbLight" Style="{StaticResource Style.RadioButton}"
                                         Content="Light" GroupName="EvtTheme"
                                         Checked="Theme_Checked"/>
                        </StackPanel>
                        <TextBlock Text="Applies straight away — the event stays open."
                                   FontSize="{StaticResource FontSize.Xs}"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
